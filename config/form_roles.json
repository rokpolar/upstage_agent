    "item_name": "품목",
    "form_name": "양식",
    "blank_filled": "본문 빈자리 채움: {value}",
    "marker_removed": "예시 표시 '{marker}' 삭제"
  },
  "leftover_check": {
    "_comment": "채운 뒤 양식에 남은 예시 값 찾기. kinds의 pattern에 맞는 글 중 우리가 쓴 값에 없는 것을 {where(칸 이름), kind, values, action}으로 보고서에 올린다(화면은 누르면 팝업). 양식은 고치지 않는다. 칸 이름은 같은 줄 '이름 :', 왼쪽 칸, 위쪽 머리글 순으로 찾고 없으면 body.",
    "kinds": [
      {
        "name": "날짜",
        "pattern": "\\d{4}\\s*[.\\-년]\\s*\\d{1,2}\\s*[.\\-월]\\s*\\d{1,2}",
        "action": "양식 견본에 원래 있던 날짜입니다. 이 품의 건의 날짜로 고치거나 지우세요."
      },
      {
        "name": "금액",
        "pattern": "\\d{1,3}(?:,\\d{3})+\\s*원?",
        "action": "이 품의 건에 없는 금액입니다. 견본의 예시 금액이면 지우세요."
      },
      {
        "name": "금액",
        "pattern": "금\\s*[일이삼사오육칠팔구십백천만억]+원",
        "action": "이 품의 건에 없는 금액입니다. 견본의 예시 금액이면 지우세요."
      }
    ],
    "body": "본문",
    "label_max_chars": 12
  },
  "inline_blanks": {
    "_comment": "문장 안 빈자리 채우기. rules마다 pattern에 맞고 context 낱말(비어 있으면 조건 없음)이 같은 문단에 있을 때만 채운다('접수 (   )' 같은 칸은 그대로). value에 쓸 수 있는 값: {item_summary}(첫 품목 외 N건), {draft_dot}(기안일, 예: 2026. 11. 5.), {project_name}(사업명, '○○○○ 다음과 같이' 자리). \\g<1>은 pattern의 첫 괄호(앞 공백 유지). strip_markers는 채운 양식에서 지울 예시 표시.",
    "item_summary": "{first_item}{more}",
    "draft_dot": "{y}. {m}. {d}.",
    "rules": [
      {
        "pattern": "\\(\\s{3,}\\)",
        "context": [
          "물품",
          "구매",
          "구입"
        ],
        "value": "({item_summary})"
      },
      {
        "pattern": "^(\\s*)20\\d{2}\\.(?:\\s*\\.){1,2}\\s*$",
        "context": [],
        "value": "\\g<1>{draft_dot}"
      },
      {
        "pattern": "^(\\s*)[〇○◯]{2,}\\s*(?=다음과)",
        "context": [],
        "value": "\\g<1>{project_name} 관련하여 "
      }
    ],
    "strip_markers": [
      "[예시]"
    ]
  }
}

      "위와같이"
    ],
    "vat_row": {
      "_comment": "견적서의 부가세를 품목 표에 한 줄로 넣어 합계(부가세 포함)와 맞춘다.",
      "enabled": true,
      "category": "부가세",
      "description": "부가가치세 ({rate}%)"
    },
    "item_name": {
      "_comment": "적요(품명) 칸에 쓸 글. 추출 결과의 설명에서 아래 정규식에 맞는 부분을 지운다(예: '문구 도매 구매를 위한 A4 파일 구매' → 'A4 파일'). 양식은 고정이고 칸에는 품명과 규격만 쓴다.",
      "strip": [
        "^.*?(?:을|를)\\s*위한\\s+",
        "\\s*(?:구매|구입)$"
      ]
    },
    "fit": {
      "_comment": "품목 표 모양 맞추기. max_row_ratio: 채운 품목 줄이 머리줄 높이의 이 배수보다 높으면 머리줄 높이로 줄인다(한글은 글자가 넘치면 알아서 늘림). number_roles 칸은 좌우 여백을 number_margin(HWPUNIT, 141 = 0.5mm) 이하로 줄인다. shrink_numbers: 숫자가 칸 안쪽 폭(char_width로 어림)보다 넓으면 양식에 있는 같은 글꼴의 더 작은 글자 모양(min_char_height 1/100pt 이상)으로 바꾼다.",
      "max_row_ratio": 1.6,
      "number_roles": [
        "quantity",
        "unit_price",
        "amount"
      ],
      "number_margin": 141,
      "shrink_numbers": true,
      "min_char_height": 800,
      "char_width": {
        "default": 0.55,
        ",": 0.3,
        ".": 0.3,
        " ": 0.3,
        "-": 0.35
      }
    }
  },
  "formats": {
    "date": "{y}년 {m}월 {d}일",
    "amount_korean": "금 {korean}원정 (￦{won})",
    "amount": "{won}",
    "checkbox_on": "■",
    "checkbox_off": "□",
    "inline_separator": " : "
  },
  "placeholders": {
    "_comment": "값 칸에 이미 있는 이런 글자는 자리표시로 보고 지운다. 그 밖의 글자는 지우지 않고 값 뒤에 남긴다.",
    "patterns": [
      "^\\s*$",
      "^년\\s*월\\s*일$",
      "^\\d{4}\\s*\\.?\\s*\\.?\\s*\\.?$",
      "^(일금|금)?\\s*원정?\\s*$",
      "^(일금|금)?\\s*원정?\\s*[￦₩\\\\]?\\s*$",
      "^(金|금)?\\s*整?\\s*\\(?\\s*[￦₩\\\\]?\\s*\\)?\\s*$",
      "^〇+",
      "^○+",
      "^제\\s*호$"
    ],
    "_keep_comment": "값 칸에 이런 글자가 있으면 지우지 않고 값 뒤에 남긴다(예: 서명란, 전화번호 라벨).",
    "keep_if_matches": [
      "\\(서명\\)",
      "전화",
      "\\(인\\)"
    ]
  },
  "free_text": {
    "_comment": "양식에 전용 칸이 없는 값은 양식 안의 넓은 빈 칸(본문 칸)에 '이름: 값' 줄로 적는다. 그런 칸도 없으면 담당자에게 묻는다.",
    "enabled": true,
    "min_colspan_ratio": 0.7,
    "anchors": [
      "다음과같이",
      "아래와같이",
      "상기와같이",
      "위와같이"

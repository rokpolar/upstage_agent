# 이 파일을 .env로 복사하고 값을 채운다. .env는 GitHub에 올리지 않는다.
# 같은 이름의 환경변수가 있으면 그 값을 먼저 쓴다. 빈 값은 config/rules.json 기본값을 쓴다.

# Upstage API 키 (console.upstage.ai/api-keys, up_로 시작). 두 워크플로가 같은 조직이면 이것 하나만 넣는다.
UPSTAGE_API_KEY=
# Agent가 Studio 프로젝트에 속해 있으면 그 프로젝트 ID(proj_...). 모든 요청에 x-project-id 헤더로 보낸다.
UPSTAGE_PROJECT_ID=

# 품의 워크플로 (견적서 → 품의서). 비우면 rules.json runtime.studio 값
PUMUI_AGENT_ID=
PUMUI_CONFIG_ID=
PUMUI_PROJECT_ID=
# 품의 워크플로가 다른 조직에 있을 때만
PUMUI_API_KEY=

# 결의 워크플로 (품의서 + 증빙 → 지출결의서). 비우면 rules.json runtime.gyeolui_studio 값
GYEOLUI_AGENT_ID=
GYEOLUI_CONFIG_ID=
GYEOLUI_PROJECT_ID=
# 결의 워크플로가 다른 조직에 있을 때만
GYEOLUI_API_KEY=

# CONFIG_ID에 latest를 넣으면 config_id를 보내지 않아 최신 설정으로 돈다.
# 예전 이름 AGENT_ID·CONFIG_ID도 품의 값으로 읽는다.

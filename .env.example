# 이 파일을 .env로 복사하고 값을 채운다. .env는 GitHub에 올리지 않는다.
# Upstage Console(console.upstage.ai) > API Keys에서 만든 키 (품의 워크플로가 있는 팀 조직 키)
UPSTAGE_API_KEY=
# config/rules.json의 runtime.studio.agent_id가 비어 있을 때만 쓴다
AGENT_ID=
CONFIG_ID=

# 결의 워크플로 키. 결의 워크플로가 다른 조직에 있을 때만 넣는다(비우면 UPSTAGE_API_KEY를 쓴다).
GYEOLUI_API_KEY=
# config/rules.json의 runtime.gyeolui_studio.agent_id가 비어 있을 때만 쓴다
GYEOLUI_AGENT_ID=
GYEOLUI_CONFIG_ID=
